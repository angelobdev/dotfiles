  "windows.transparency": { "label": "commands.windows.transparency", "bind": "Window transparency", "icon": "eye", "run": ["hyprctl", "eval", "desktop_window_trick(\"transparency\")"] },
  "windows.workspaceGaps": { "label": "commands.windows.workspaceGaps", "bind": "Gaps on this workspace", "icon": "split", "run": ["hyprctl", "eval", "desktop_window_trick(\"workspaceGaps\")"] },
  "windows.tiledFullscreen": { "label": "commands.windows.tiledFullscreen", "bind": "Tiled fullscreen", "icon": "fullscreen", "run": ["hyprctl", "eval", "desktop_window_trick(\"tiledFullscreen\")"] },
  "windows.fullscreenDesktop": { "label": "commands.windows.fullscreenDesktop", "bind": "Full-screen desktop", "icon": "monitor", "run": ["hyprctl", "eval", "desktop_window_trick(\"fullscreenDesktop\")"] },
  "windows.close": { "label": "commands.windows.close", "bind": "Close window", "icon": "close", "run": ["hyprctl", "dispatch", "hl.dsp.window.close()"] },

