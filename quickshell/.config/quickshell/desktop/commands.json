  "toggles.zoom": { "label": "commands.toggles.zoom", "icon": "zoom", "state": "zoom", "call": ["zoom", "toggle"] },
  "toggles.rotationLock": { "label": "commands.toggles.rotationLock", "icon": "rotate-lock", "when": "rotation", "state": "rotationLock", "call": ["rotationLock", "toggle"] },
