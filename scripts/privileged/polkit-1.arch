#%PAM-1.0
# Written by the desktop installer (hardware profile); sudo, GDM and hyprlock keep system-auth.
# The polkit prompt asks for the password at once. An empty answer ("Use fingerprint" in the shell's prompt) moves to
# the reader instead, except in tablet mode, where the screen covers it (scripts/tablet-auth.sh). As in system-auth,
# pam_faillock counts wrong passwords; a fingerprint that did not answer is not counted.
auth       required                     pam_faillock.so preauth
auth       required                     pam_env.so
# The prompt. A password skips the three lines after this one, straight to the second pam_unix.
auth       [success=ok default=3]       pam_exec.so quiet expose_authtok /usr/local/libexec/desktop-fingerprint-wanted
auth       [success=1 default=ignore]   pam_exec.so quiet /usr/local/libexec/desktop-tablet-mode
auth       sufficient                   pam_fprintd.so
# The fingerprint did not answer: only an account without a password gets in with the empty answer.
auth       [success=done default=die]   pam_unix.so use_first_pass nullok
auth       [success=1 default=bad]      pam_unix.so use_first_pass nullok
auth       [default=die]                pam_faillock.so authfail
auth       required                     pam_faillock.so authsucc
account    include      system-auth
password   include      system-auth
session    include      system-auth
