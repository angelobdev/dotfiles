[Desktop Entry]
Name=Steam
Comment=Steam client with monitor-aware UI scaling
Exec=/home/angelo/.local/bin/desktop-steam %U
TryExec=/usr/bin/steam
Icon=steam
Terminal=false
Type=Application
StartupNotify=true
StartupWMClass=Steam
Categories=Game;
MimeType=x-scheme-handler/steam;x-scheme-handler/steamlink;
PrefersNonDefaultGPU=true
Actions=Store;Community;Library;Servers;Screenshots;News;Settings;BigPicture;Friends;

[Desktop Action Store]
Name=Store
Exec=/home/angelo/.local/bin/desktop-steam steam://store

[Desktop Action Community]
Name=Community
Exec=/home/angelo/.local/bin/desktop-steam steam://url/CommunityHome/

[Desktop Action Library]
Name=Library
Exec=/home/angelo/.local/bin/desktop-steam steam://open/games

[Desktop Action Servers]
Name=Servers
Exec=/home/angelo/.local/bin/desktop-steam steam://open/servers

[Desktop Action Screenshots]
Name=Screenshots
Exec=/home/angelo/.local/bin/desktop-steam steam://open/screenshots

[Desktop Action News]
Name=News
Exec=/home/angelo/.local/bin/desktop-steam steam://openurl/https://store.steampowered.com/news

[Desktop Action Settings]
Name=Settings
Exec=/home/angelo/.local/bin/desktop-steam steam://open/settings

[Desktop Action BigPicture]
Name=Big Picture
Exec=/home/angelo/.local/bin/desktop-steam steam://open/bigpicture

[Desktop Action Friends]
Name=Friends
Exec=/home/angelo/.local/bin/desktop-steam steam://open/friends
