# Generated by desktop-theme for qt5ct and qt6ct; edits here are replaced on the next theme change.
[Appearance]
color_scheme_path={{ paths.state }}/qt-colors.conf
custom_palette=true
icon_theme={{ system.iconTheme }}
standard_dialogs=default
style=Fusion

[Fonts]
fixed="{{ fonts.mono }},{{ fonts.size }},-1,5,50,0,0,0,0,0"
general="{{ fonts.sans }},{{ fonts.size }},-1,5,50,0,0,0,0,0"

[Interface]
activate_item_on_single_click=0
buttonbox_layout=0
dialog_buttons_have_icons=1
menus_have_icons=true
toolbutton_style=4
underline_shortcut=1
