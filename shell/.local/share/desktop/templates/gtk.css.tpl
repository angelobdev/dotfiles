/* Desktop palette; native GTK and libadwaita widgets keep their own geometry. */
@define-color theme_bg_color {{ palette.bg | hex }};
@define-color theme_fg_color {{ palette.fg | hex }};
@define-color theme_base_color {{ palette.base | hex }};
@define-color theme_text_color {{ palette.fg | hex }};
@define-color theme_selected_bg_color {{ palette.accent | hex }};
@define-color theme_selected_fg_color {{ palette.accentFg | hex }};
@define-color borders {{ palette.border | hex }};
@define-color theme_unfocused_bg_color {{ palette.base | hex }};
@define-color theme_unfocused_fg_color {{ palette.muted | hex }};
@define-color accent_bg_color {{ palette.accent | hex }};
@define-color accent_fg_color {{ palette.accentFg | hex }};
@define-color accent_color {{ palette.accent | hex }};
@define-color window_bg_color {{ palette.bg | hex }};
@define-color window_fg_color {{ palette.fg | hex }};
@define-color view_bg_color {{ palette.base | hex }};
@define-color view_fg_color {{ palette.fg | hex }};
@define-color headerbar_bg_color {{ palette.raised | hex }};
@define-color headerbar_fg_color {{ palette.fg | hex }};
@define-color headerbar_border_color {{ palette.border | hex }};
@define-color headerbar_backdrop_color {{ palette.base | hex }};
@define-color card_bg_color {{ palette.raised | hex }};
@define-color card_fg_color {{ palette.fg | hex }};
@define-color popover_bg_color {{ palette.raised | hex }};
@define-color popover_fg_color {{ palette.fg | hex }};
@define-color dialog_bg_color {{ palette.raised | hex }};
@define-color dialog_fg_color {{ palette.fg | hex }};
@define-color sidebar_bg_color {{ palette.base | hex }};
@define-color sidebar_fg_color {{ palette.fg | hex }};
@define-color sidebar_backdrop_color {{ palette.bg | hex }};
@define-color destructive_bg_color {{ palette.danger | hex }};
@define-color destructive_fg_color {{ palette.accentFg | hex }};
@define-color success_bg_color {{ palette.success | hex }};
@define-color success_fg_color {{ palette.accentFg | hex }};
@define-color warning_bg_color {{ palette.warning | hex }};
@define-color warning_fg_color {{ palette.accentFg | hex }};
@define-color error_bg_color {{ palette.danger | hex }};
@define-color error_fg_color {{ palette.accentFg | hex }};
