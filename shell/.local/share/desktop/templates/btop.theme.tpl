# Generated by desktop-theme from the current theme (installed as btop's "desktop" theme).
# An empty main background keeps the terminal's own, translucent background.
theme[main_bg]=""
theme[main_fg]="{{ palette.fg | hex }}"
theme[title]="{{ palette.fg | hex }}"
theme[hi_fg]="{{ palette.accent | hex }}"
theme[selected_bg]="{{ palette.raised | hex }}"
theme[selected_fg]="{{ palette.accent | hex }}"
theme[inactive_fg]="{{ palette.dim | hex }}"
theme[graph_text]="{{ palette.muted | hex }}"
theme[meter_bg]="{{ palette.raised | hex }}"
theme[proc_misc]="{{ palette.accent | hex }}"
theme[cpu_box]="{{ palette.accent | hex }}"
theme[mem_box]="{{ palette.success | hex }}"
theme[net_box]="{{ ansi.5 | hex }}"
theme[proc_box]="{{ ansi.4 | hex }}"
theme[div_line]="{{ palette.border | hex }}"
theme[temp_start]="{{ palette.success | hex }}"
theme[temp_mid]="{{ palette.warning | hex }}"
theme[temp_end]="{{ palette.danger | hex }}"
theme[cpu_start]="{{ ansi.6 | hex }}"
theme[cpu_mid]="{{ ansi.4 | hex }}"
theme[cpu_end]="{{ palette.accent | hex }}"
theme[free_start]="{{ ansi.5 | hex }}"
theme[free_mid]="{{ ansi.4 | hex }}"
theme[free_end]="{{ ansi.12 | hex }}"
theme[cached_start]="{{ ansi.6 | hex }}"
theme[cached_mid]="{{ ansi.4 | hex }}"
theme[cached_end]="{{ ansi.12 | hex }}"
theme[available_start]="{{ palette.warning | hex }}"
theme[available_mid]="{{ ansi.11 | hex }}"
theme[available_end]="{{ palette.danger | hex }}"
theme[used_start]="{{ palette.success | hex }}"
theme[used_mid]="{{ ansi.6 | hex }}"
theme[used_end]="{{ ansi.14 | hex }}"
theme[download_start]="{{ palette.warning | hex }}"
theme[download_mid]="{{ ansi.5 | hex }}"
theme[download_end]="{{ palette.danger | hex }}"
theme[upload_start]="{{ palette.success | hex }}"
theme[upload_mid]="{{ ansi.6 | hex }}"
theme[upload_end]="{{ ansi.14 | hex }}"
theme[process_start]="{{ ansi.6 | hex }}"
theme[process_mid]="{{ ansi.4 | hex }}"
theme[process_end]="{{ palette.accent | hex }}"
