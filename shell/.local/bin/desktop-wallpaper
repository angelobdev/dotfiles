#!/usr/bin/env bash
set -euo pipefail
if [[ $# == 0 ]]; then
    exec "$HOME/.local/bin/desktop-shell" toggle wallpaper
fi
# The next image of the current theme's set, applied through wallpaper.py.
if [[ $1 == --next ]]; then
    exec python3 "$HOME/.local/libexec/desktop/theme.py" next-wallpaper
fi
exec python3 "$HOME/.local/libexec/desktop/wallpaper.py" "$@"
