#!/usr/bin/env bash
set -euo pipefail
# Hyprland's exec PATH does not include ~/.local/bin, where the Claude Code installer puts `claude`.
export PATH="$HOME/.local/bin:$PATH"
case "${1:-toggle}" in
    toggle)
        # One press at a time, so a second press before the window maps sees the first one's launch.
        exec 9>"${XDG_RUNTIME_DIR:-/tmp}/desktop-ai.lock"
        flock 9
        starting="${XDG_RUNTIME_DIR:-/tmp}/desktop-ai.starting"
        # The console: the Herdr app when herdr is installed (every agent, kept running by herdr-core), else
        # Claude Code in Kitty. DESKTOP_AI_CONSOLE=kitty keeps Kitty with herdr installed.
        class=desktop-ai
        if [[ ${DESKTOP_AI_CONSOLE:-} != kitty ]] && command -v herdr-app >/dev/null; then
            class=herdr-app
        fi
        # Where it runs: in the console (toggle it), moved out of it (bring it back), or not yet.
        place="$(hyprctl clients -j | python3 -c '
import json, sys
names = [c.get("workspace", {}).get("name", "") for c in json.load(sys.stdin) if c.get("class") == sys.argv[1]]
print("" if not names else "inside" if "special:ai" in names else "outside")
' "$class")"
        if [[ $place == inside ]]; then
            exec hyprctl dispatch 'hl.dsp.workspace.toggle_special("ai")'
        elif [[ $place == outside ]]; then
            exec hyprctl eval 'desktop_console_show()'
        fi
        # Launched less than 10 s ago and not mapped yet: a second session would start.
        if [[ -e $starting ]] && (( $(date +%s) - $(stat -c %Y "$starting") < 10 )); then
            exit 0
        fi
        # The Herdr app: its window rule (desktop-ai-herdr) places it in the console; herdr-core keeps the
        # terminals and agents, which the shell follows through hc events.
        if [[ $class == herdr-app ]]; then
            touch "$starting"
            setsid -f herdr-app >/dev/null 2>&1 9>&-
            exit 0
        fi
        if ! command -v claude >/dev/null; then
            exec python3 "$HOME/.local/libexec/desktop/i18n.py" --notify assistant.title assistant.errors.claudeMissing
        fi
        # Session-only settings: hold-Space dictation, and one language for dictation and replies
        # (the system locale unless DESKTOP_AI_LANGUAGE names another, e.g. "italian"). agent.py gets the
        # status line (usage for the shell panel) and the hooks that tell the shell what Claude is doing;
        # they run async, so they never hold Claude up, except SessionEnd, which must finish before exit.
        language="${DESKTOP_AI_LANGUAGE:-$(python3 "$HOME/.local/libexec/desktop/i18n.py" assistant.language)}"
        settings="$(python3 -c '
import json, sys
language, helper = sys.argv[1:]
command = "python3 " + json.dumps(helper)
def hook(asynchronous=True, matcher=None):
    entry = {"hooks": [dict({"type": "command", "command": command + " hook", "timeout": 5},
                            **({"async": True} if asynchronous else {}))]}
    return [dict(entry, matcher=matcher) if matcher else entry]
hooks = {name: hook() for name in ("SessionStart", "UserPromptSubmit", "PermissionRequest", "PostToolUse",
                                   "PostToolUseFailure", "PermissionDenied", "Stop", "StopFailure")}
hooks.update(Notification=hook(matcher="permission_prompt"), SessionEnd=hook(asynchronous=False))
print(json.dumps({"voice": {"enabled": True, "mode": "hold"}, "language": language,
                  "statusLine": {"type": "command", "command": command + " statusline", "padding": 0},
                  "disableAllHooks": False, "hooks": hooks}))
' "$language" "$HOME/.local/libexec/desktop/agent.py")"
        # The session starts in the dotfiles repository (this script is a Stow link into it), so Claude
        # reads its .claude/CLAUDE.md; DESKTOP_AI_DIRECTORY names another folder, $HOME is the fallback.
        repo="$(cd "$(dirname "$(readlink -f "$0")")/../../.." && pwd)"
        directory="${DESKTOP_AI_DIRECTORY:-$repo}"
        [[ -d $directory ]] || directory="$HOME"
        # The desktop-ai window rule places the window on the special workspace "ai".
        touch "$starting"
        # Remote control on a socket of this window only (desktop-area ask types an image path at the prompt);
        # the runtime directory is the user's alone, and other kitty windows keep it off.
        socket="${XDG_RUNTIME_DIR:-/tmp}/desktop-ai-kitty"
        rm -f "$socket"
        # Without the lock (9>&-): kitty would hold it, and every later press would wait for its lifetime.
        setsid -f kitty --class desktop-ai --directory "$directory" -o allow_remote_control=socket-only \
            --listen-on "unix:$socket" -e claude --settings "$settings" >/dev/null 2>&1 9>&-
        ;;
    *) echo 'Usage: desktop-ai [toggle]' >&2; exit 2 ;;
esac
