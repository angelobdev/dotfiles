#!/usr/bin/env bash
set -euo pipefail
backend=wayland
case "${1:-}" in
    --x11) backend=x11; shift ;;
    --wayland) shift ;;
esac
if [[ $# -eq 0 ]]; then
    echo 'Usage: desktop-electron [--wayland|--x11] PROGRAM [ARGUMENTS...]' >&2
    exit 2
fi
program=$1; shift
exec "$program" "--ozone-platform=$backend" "$@"
