#!/usr/bin/env bash
set -euo pipefail
export QT_QPA_PLATFORMTHEME=qt5ct
export QT_QUICK_CONTROLS_STYLE=Basic
helper="$HOME/.local/libexec/desktop/theme.py"
case "${1:-apply}" in
    apply)
        # Keep the settings found before the first themed session, so they can be restored by hand.
        if command -v gsettings >/dev/null; then
            state="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles"
            mkdir -p "$state"
            # Complete or absent: written aside and moved in only once gsettings succeeded. A failure (a missing
            # schema) leaves no empty backup behind and does not stop the theme below.
            if [[ ! -e "$state/interface-before-theme.ini" ]]; then
                if gsettings list-recursively org.gnome.desktop.interface >"$state/interface-before-theme.ini.tmp"; then
                    mv "$state/interface-before-theme.ini.tmp" "$state/interface-before-theme.ini"
                else
                    rm -f "$state/interface-before-theme.ini.tmp"
                fi
            fi
        fi
        # Renders the current theme and sets its gsettings, which also inform portal-aware
        # applications, including GTK4/libadwaita.
        python3 "$helper" apply
        ;;
    set)
        [[ -n "${2:-}" ]] || { echo 'Usage: desktop-theme set THEME' >&2; exit 2; }
        exec python3 "$helper" set "$2"
        ;;
    list) exec python3 "$helper" list ;;
    # Preferences that apply across themes (the Theming panel uses the same commands).
    font|icon-theme|cursor|text-scale|shell-icons|bar-style|reduce-effects|window-style|glass|generate|dynamic) exec python3 "$helper" "$@" ;;
    *) echo 'Usage: desktop-theme [apply | set THEME | list | font ... | icon-theme NAME | cursor [--theme NAME] [--size N] | text-scale 1|1.15|1.3|1.5 | shell-icons desktop|pack | bar-style shade|transparent|toggle | reduce-effects on|off|toggle | window-style --rounding N --border N --gaps-in N --gaps-out N | glass (--option OPTION --value N | --reset) | generate [--image PATH] | dynamic [--mode M]]' >&2; exit 2 ;;
esac
