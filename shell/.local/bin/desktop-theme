#!/usr/bin/env bash
set -euo pipefail
export QT_QPA_PLATFORMTHEME=qt5ct
export QT_QUICK_CONTROLS_STYLE=Basic
helper="$HOME/.local/libexec/desktop/theme.py"
case "${1:-apply}" in
    apply)
        # Keep the settings found before the first themed session, so they can be restored by hand.
        if command -v gsettings >/dev/null; then
            state="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles"
            mkdir -p "$state"
            if [[ ! -e "$state/interface-before-theme.ini" ]]; then
                gsettings list-recursively org.gnome.desktop.interface >"$state/interface-before-theme.ini"
            fi
        fi
        # Renders the current theme and sets its gsettings, which also inform portal-aware
        # applications, including GTK4/libadwaita.
        python3 "$helper" apply
        if [[ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]]; then
            dbus-update-activation-environment --systemd QT_QPA_PLATFORMTHEME QT_QUICK_CONTROLS_STYLE
        fi
        ;;
    set)
        [[ -n "${2:-}" ]] || { echo 'Usage: desktop-theme set THEME' >&2; exit 2; }
        exec python3 "$helper" set "$2"
        ;;
    list) exec python3 "$helper" list ;;
    # Preferences that apply across themes (the Theming panel uses the same commands).
    font|icon-theme|shell-icons|bar-style|window-style|generate|dynamic) exec python3 "$helper" "$@" ;;
    *) echo 'Usage: desktop-theme [apply | set THEME | list | font ... | icon-theme NAME | shell-icons desktop|pack | bar-style shade|transparent|toggle | window-style --rounding N --border N | generate [--image PATH] | dynamic [--mode M] [--scheme S]]' >&2; exit 2 ;;
esac
