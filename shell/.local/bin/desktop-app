#!/usr/bin/env bash
# The default apps of the shortcuts, as chosen in Settings → Apps: desktop-app {terminal|browser|passwords|files}.
set -euo pipefail
case "${1:-}" in
    terminal | browser | passwords | files) ;;
    *)
        echo 'Usage: desktop-app {terminal|browser|passwords|files}' >&2
        exit 2
        ;;
esac
# The terminal is how a broken setup is mended: kitty when the helper itself fails.
python3 "$HOME/.local/libexec/desktop/apps.py" launch "$1" || {
    status=$?
    [[ $1 == terminal ]] && exec kitty
    exit "$status"
}
