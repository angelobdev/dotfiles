#!/usr/bin/env bash
set -euo pipefail
message() { python3 "$HOME/.local/libexec/desktop/i18n.py" "$@"; }
case "${1:-}" in
    lock)
        command -v hyprlock >/dev/null || { message 'session.errors.lockMissing' >&2; exit 1; }
        [[ -n "${XDG_RUNTIME_DIR:-}" ]] || { message 'session.errors.waylandRequired' >&2; exit 1; }
        # Serialize all lock requests; a second request is already satisfied.
        exec 9>"$XDG_RUNTIME_DIR/desktop-lock.lock"
        flock -n 9 || exit 0
        pgrep -u "$EUID" -x hyprlock >/dev/null && exit 0
        # The current theme renders a full hyprlock config; without it, hyprlock reads the stowed one.
        themed="${XDG_STATE_HOME:-$HOME/.local/state}/desktop-theme/hyprlock.conf"
        config=()
        [[ -s "$themed" ]] && config=(--config "$themed")
        # The shell shows the on-screen keyboard over the lock in tablet mode, where there is no other
        # keyboard to type the password with; it is told when the lock goes.
        # Every call to the shell or the compositor is bounded: a hung shell must never keep the session
        # unlocked (and the flock above held, so that later requests exit silently).
        logger -t desktop-shell "lock start" 2>/dev/null || true
        timeout 2 "$HOME/.local/bin/desktop-shell" keyboard locked >/dev/null 2>&1 || true
        # In tablet mode hyprlock gets a copy of its config: fingerprint unlock off, as the folded screen
        # covers the reader (hyprlock reads it itself, not through PAM), and the widgets anchored to the
        # bottom (user, password field, messages) lifted so the field sits above the keyboard with the same
        # gap as between the field and the user name. hyprlock positions are physical pixels, the shell
        # reports the keyboard height in logical ones, hence the monitor scale.
        posture="$XDG_RUNTIME_DIR/desktop-shell/tablet.json"
        if [[ -s "$themed" ]] && grep -Eq '"tablet"[[:space:]]*:[[:space:]]*true' "$posture" 2>/dev/null; then
            tablet="$XDG_RUNTIME_DIR/desktop-hyprlock-tablet.conf"
            keyboard=$(timeout 2 "$HOME/.local/bin/desktop-shell" status 2>/dev/null | python3 -c '
import json, sys
area = json.load(sys.stdin).get("keyboard", {}).get("area") or []
print(area[0] + " " + str(area[4]) if len(area) == 5 else "")' 2>/dev/null || true)
            scale=$(timeout 2 hyprctl -j monitors 2>/dev/null | python3 -c '
import json, sys
name = sys.argv[1]
print(next((m["scale"] for m in json.load(sys.stdin) if m["name"] == name), 1))' "${keyboard%% *}" 2>/dev/null || echo 1)
            # A failure here keeps the themed config rather than aborting the lock.
            if python3 - "$themed" "$tablet" "${keyboard#* }" "${scale:-1}" <<'PY'
import re
import sys
source, target = sys.argv[1], sys.argv[2]
try:
    keyboard = float(sys.argv[3]) * float(sys.argv[4])
except ValueError:
    keyboard = 0
blocks, block = [], []
for line in open(source, encoding='utf-8'):
    block.append(re.sub(r'^(\s*fingerprint:enabled\s*=).*', r'\1 false', line))
    if line.strip() == '}':
        blocks.append(block)
        block = []
if block:
    blocks.append(block)
def value(block, key):
    for line in block:
        match = re.match(r'\s*' + key + r'\s*=\s*(-?\d+)\s*,\s*(-?\d+)', line)
        if match:
            return int(match[1]), int(match[2])
    return None
bottom = [b for b in blocks if any(re.match(r'\s*valign\s*=\s*bottom', line) for line in b)]
field = next((b for b in bottom if b[0].strip().startswith('input-field')), None)
lift = 0
if field and keyboard > 0:
    y, height = value(field, 'position')[1], value(field, 'size')[1]
    above = [value(b, 'position')[1] for b in bottom if b is not field and value(b, 'position') and value(b, 'position')[1] > y]
    gap = min(above) - (y + height) if above else 32
    lift = max(0, round(keyboard + gap - y))
out = []
for b in blocks:
    if b in bottom:
        b = [re.sub(r'^(\s*position\s*=\s*-?\d+\s*,\s*)(-?\d+)', lambda m: m[1] + str(int(m[2]) + lift), line) for line in b]
    out += b
open(target, 'w', encoding='utf-8').write(''.join(out))
PY
            then
                config=(--config "$tablet")
            fi
        fi
        status=0
        hyprlock --grace 0 "${config[@]}" || status=$?
        timeout 2 "$HOME/.local/bin/desktop-shell" keyboard unlocked >/dev/null 2>&1 || true
        logger -t desktop-shell "lock end ($status)" 2>/dev/null || true
        exit "$status"
        ;;
    suspend)
        command -v hyprlock >/dev/null || { message 'session.errors.suspendLockMissing' >&2; exit 1; }
        pgrep -u "$EUID" -x hypridle >/dev/null || {
            message 'session.errors.idleNotRunning' >&2
            exit 1
        }
        # hypridle holds a logind delay inhibitor until ext-session-lock is locked.
        # Its before_sleep_cmd also covers lid close and externally requested sleep.
        exec systemctl suspend
        ;;
    logout) exec hyprctl dispatch 'hl.dsp.exit()' ;;
    reboot|poweroff) exec systemctl "$1" ;;
    *) message 'session.errors.usage' >&2; exit 2 ;;
esac
