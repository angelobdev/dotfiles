#!/usr/bin/env bash
set -euo pipefail
config="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/desktop"
case "${1:-start}" in
    start) exec qs -p "$config" --no-duplicate --daemonize ;;
    stop) exec qs kill -p "$config" ;;
    restart)
        # "restart theming TAB" reopens the Theming panel on TAB once the new instance answers.
        case "${2:-}" in
            '') ;;
            theming) [[ "${3:-}" =~ ^(theme|wallpaper|font|icons)$ ]] || { echo 'Usage: desktop-shell restart [theming theme|wallpaper|font|icons]' >&2; exit 2; } ;;
            *) echo 'Usage: desktop-shell restart [theming theme|wallpaper|font|icons]' >&2; exit 2 ;;
        esac
        qs kill -p "$config" 2>/dev/null || true
        # kill requests shutdown; --no-duplicate can still see the exiting process.
        # Wait for Quickshell's instance lock to disappear before starting again.
        for attempt in {1..50}; do
            if ! qs list --json -p "$config" 2>/dev/null | python3 -c '
import json, sys
try:
    running = bool(json.load(sys.stdin))
except ValueError:
    running = False
sys.exit(0 if running else 1)
'; then
                if [[ -z "${2:-}" ]]; then
                    exec qs -p "$config" --no-duplicate --daemonize
                fi
                qs -p "$config" --no-duplicate --daemonize
                for ready in {1..100}; do
                    if qs ipc -p "$config" call desktop status >/dev/null 2>&1; then
                        exec qs ipc -p "$config" call desktop theming "$3"
                    fi
                    sleep 0.1
                done
                exit 0
            fi
            sleep 0.1
        done
        echo 'The previous Quickshell instance did not exit within 5 seconds.' >&2
        exit 1
        ;;
    toggle)
        case "${2:-}" in launcher|controls|network|bluetooth|audio|battery|notifications|calendar|hints|wallpaper|theming|clipboard|recording|power) ;;
            *) echo 'Usage: desktop-shell toggle {launcher|controls|network|bluetooth|audio|battery|notifications|calendar|hints|wallpaper|theming|clipboard|recording|power}' >&2; exit 2 ;;
        esac
        exec qs ipc -p "$config" call desktop toggle "$2"
        ;;
    media)
        case "${2:-}" in play-pause|play|pause|next|previous|stop) ;;
            *) echo 'Usage: desktop-shell media {play-pause|play|pause|next|previous|stop}' >&2; exit 2 ;;
        esac
        exec qs ipc -p "$config" call desktop media "$2"
        ;;
    dock)
        case "${2:-}" in
            # "--" keeps qs from reading "show" as its own subcommand.
            # touch: shown for touch (no keyboard surface), as the assist button does in tablet mode.
            show|hide|toggle|touch) exec qs ipc -p "$config" call desktop dock -- "$2" ;;
            launch)
                if [[ "${3:-}" =~ ^[1-9]$ ]]; then
                    exec qs ipc -p "$config" call desktop dockLaunch "$3"
                fi
                ;;
        esac
        echo 'Usage: desktop-shell dock {show|hide|toggle|touch|launch 1-9}' >&2
        exit 2
        ;;
    keep-awake|dnd|tablet|rotation-lock|night-shift)
        # Night shift also has its automatic mode.
        actions='toggle|on|off'
        [[ $1 == night-shift ]] && actions+='|auto'
        [[ "|$actions|" == *"|${2:-}|"* ]] || { echo "Usage: desktop-shell $1 {$actions}" >&2; exit 2; }
        # tablet: the tablet mode switch reports through here (config/tablet.lua). Posture changes go to the
        # journal (journalctl -t desktop-shell) with the process that asked, to follow them around the lock.
        if [[ $1 == tablet ]]; then
            logger -t desktop-shell "tablet $2 from $(ps -o comm= -p "$PPID" 2>/dev/null || echo unknown)" 2>/dev/null || true
        fi
        case $1 in
            dnd) target=quiet ;;
            tablet) target=tablet ;;
            rotation-lock) target=rotationLock ;;
            night-shift) target=nightShift ;;
            *) target=keepAwake ;;
        esac
        exec qs ipc -p "$config" call desktop "$target" -- "$2"
        ;;
    keyboard)
        # locked / unlocked come from desktop-power around hyprlock.
        case "${2:-}" in show|hide|toggle|float|dock|locked|unlocked) ;;
            *) echo 'Usage: desktop-shell keyboard {show|hide|toggle|float|dock|locked|unlocked}' >&2; exit 2 ;;
        esac
        exec qs ipc -p "$config" call desktop keyboard -- "$2"
        ;;
    assist)
        case "${2:-}" in show|hide|toggle|menu) ;;
            *) echo 'Usage: desktop-shell assist {show|hide|toggle|menu [apps|window|system]}' >&2; exit 2 ;;
        esac
        # menu PAGE opens the menu on that page.
        [[ $2 == menu && -n "${3:-}" ]] && exec qs ipc -p "$config" call desktop assistPage -- "$3"
        exec qs ipc -p "$config" call desktop assist -- "$2"
        ;;
    window-menu) exec qs ipc -p "$config" call desktop windowMenu ;;
    status) exec qs ipc -p "$config" call desktop status ;;
    *) echo 'Usage: desktop-shell {start|stop|restart [theming TAB]|status|toggle PANEL|media ACTION|dock ACTION|keep-awake ACTION|dnd ACTION|tablet ACTION|rotation-lock ACTION|night-shift ACTION|assist ACTION|keyboard ACTION|window-menu}' >&2; exit 2 ;;
esac
