#!/usr/bin/env bash
set -euo pipefail
config="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/desktop"
# Quickshell's crash handler relaunches a crashed shell by itself and opens a report window. It crashed on exit
# (teardown bugs of 0.3.2), so every restart raced its relaunch for the polkit agent and the notification
# server. The supervisor below restarts the shell instead; core dumps stay in coredumpctl.
export QS_DISABLE_CRASH_HANDLER=1
# Present after `stop`: the supervisor leaves the shell off until `start` or `restart`.
stopped="${XDG_RUNTIME_DIR:-/tmp}/desktop-shell.stopped"
# Quickshell's own instance list: after a crash its handler relaunches the shell under another command line,
# so the process name says nothing.
running() {
    [[ $(qs list --json -p "$config" 2>/dev/null) == *'"pid"'* ]]
}
# The pid of the running shell from that list, or nothing.
shell_pid() {
    local list
    list=$(qs list --json -p "$config" 2>/dev/null) || true
    [[ $list =~ \"pid\":\ *([0-9]+) ]] && echo "${BASH_REMATCH[1]}"
    return 0
}
# Sets since to the start time of PID (field 22 of /proc/PID/stat), empty once it is gone. Builtins only, no
# subshell: with the pid it tells a reused pid apart.
started() {
    local line fields
    since=''
    { read -r line <"/proc/$1/stat"; } 2>/dev/null || return 0
    read -r -a fields <<<"${line##*) }"
    since=${fields[19]}
}
case "${1:-start}" in
    start)
        rm -f "$stopped"
        exec qs -p "$config" --no-duplicate --daemonize
        ;;
    stop)
        touch "$stopped"
        exec qs kill -p "$config"
        ;;
    supervise)
        # Started once per session (session.lua): brings the shell back after a crash. It is also the notification
        # daemon, the polkit agent and the on-screen keyboard over the lock screen, so a tablet without it has no way
        # to type the password. Five restarts within five minutes slow it down to one a minute.
        exec 8>"${XDG_RUNTIME_DIR:-/tmp}/desktop-shell-supervise.lock"
        flock -n 8 || exit 0
        restarts=()
        # Waits with the read builtin on a pipe nobody writes: no sleep process every few seconds.
        exec 7<> <(:)
        pid='' start='' since=''
        while :; do
            # While the shell found last time is alive, nothing else runs: qs list (a Qt program) only after it ended.
            if [[ -n $pid ]]; then
                started "$pid"
                if [[ $since == "$start" ]]; then
                    read -r -t 3 -u 7 || true
                    continue
                fi
            fi
            pid=$(shell_pid) start=''
            if [[ -n $pid ]]; then
                started "$pid"
                start=$since
                [[ -n $start ]] || pid=''
            fi
            if [[ ! -e $stopped && -z $pid ]]; then
                now=$(date +%s)
                recent=()
                for at in "${restarts[@]}"; do (( now - at < 300 )) && recent+=("$at"); done
                restarts=("${recent[@]}" "$now")
                (( ${#restarts[@]} > 1 )) && echo "desktop-shell: Quickshell is not running, starting it again." >&2
                qs -p "$config" --no-duplicate --daemonize 7>&- 8>&- || true
                (( ${#restarts[@]} >= 5 )) && { read -r -t 60 -u 7 || true; }
            fi
            read -r -t 3 -u 7 || true
        done
        ;;
    restart)
        # The supervisor waits while the old instance exits, or it would start one first.
        touch "$stopped"
        trap 'rm -f "$stopped"' EXIT
        # "restart theming TAB" reopens the Theming panel on TAB once the new instance answers.
        case "${2:-}" in
            '') ;;
            theming) [[ "${3:-}" =~ ^(theme|wallpaper|font|icons|cursors)$ ]] || { echo 'Usage: desktop-shell restart [theming theme|wallpaper|font|icons|cursors]' >&2; exit 2; } ;;
            *) echo 'Usage: desktop-shell restart [theming theme|wallpaper|font|icons|cursors]' >&2; exit 2 ;;
        esac
        old=$(qs list --json -p "$config" 2>/dev/null | grep -o '"pid": *[0-9]*' | grep -o '[0-9]*$' || true)
        qs kill -p "$config" 2>/dev/null || true
        # Wait until the old instance is gone before starting again: its lock goes first, but it releases its
        # polkit agent and the notification server only as its process exits, and the new one would start
        # without them.
        exited() {
            local pid
            for pid in $old; do kill -0 "$pid" 2>/dev/null && return 1; done
            return 0
        }
        for attempt in {1..50}; do
            if ! running && exited; then
                rm -f "$stopped"  # exec skips the EXIT trap.
                if [[ -z "${2:-}" ]]; then
                    exec qs -p "$config" --no-duplicate --daemonize
                fi
                qs -p "$config" --no-duplicate --daemonize
                for ready in {1..100}; do
                    if qs ipc -p "$config" call desktop status >/dev/null 2>&1; then
                        exec qs ipc -p "$config" call desktop theming "$3"
                    fi
                    sleep 0.1
                done
                exit 0
            fi
            sleep 0.1
        done
        echo 'The previous Quickshell instance did not exit within 5 seconds.' >&2
        exit 1
        ;;
    switcher)
        case "${2:-}" in next|previous|commit|cancel) ;;
            *) echo 'Usage: desktop-shell switcher {next|previous|commit|cancel}' >&2; exit 2 ;;
        esac
        exec qs ipc -p "$config" call desktop switcher "$2"
        ;;
    toggle)
        case "${2:-}" in launcher|controls|network|bluetooth|audio|battery|notifications|calendar|hints|wallpaper|settings|theming|clipboard|recording|power|agent|updates|emoji|displays) ;;
            *) echo 'Usage: desktop-shell toggle {launcher|controls|network|bluetooth|audio|battery|notifications|calendar|hints|wallpaper|settings|theming|clipboard|recording|power|agent|updates|emoji|displays} [SECTION]' >&2; exit 2 ;;
        esac
        # settings SECTION[/TAB] opens Settings on that section (appearance, system/advanced, …) instead of
        # toggling it; theming is Settings → Appearance (ShellState.aliases).
        if [[ $2 == settings && -n ${3:-} ]]; then
            [[ $3 =~ ^[a-z-]+(/[a-z-]+)?$ ]] || { echo 'Usage: desktop-shell toggle settings [SECTION[/TAB]]' >&2; exit 2; }
            exec qs ipc -p "$config" call desktop settings "$3"
        fi
        exec qs ipc -p "$config" call desktop toggle "$2"
        ;;
    media)
        case "${2:-}" in
            play-pause|play|pause|next|previous|stop) ;;
            now)
                # One line for the lock screen (hyprlock): what plays, from MPRIS without the shell, Pango-escaped.
                command -v playerctl >/dev/null || exit 0
                title=$(playerctl -s metadata title 2>/dev/null || true)
                [[ -n $title ]] || exit 0
                artist=$(playerctl -s metadata artist 2>/dev/null || true)
                [[ $(playerctl -s status 2>/dev/null) == Playing ]] && icon='▶' || icon='⏸'
                line="$icon  ${title:0:60}${artist:+  ·  ${artist:0:40}}"
                line=${line//&/&amp;}; line=${line//</&lt;}; line=${line//>/&gt;}
                printf '%s\n' "$line"
                exit 0
                ;;
            *) echo 'Usage: desktop-shell media {play-pause|play|pause|next|previous|stop|now}' >&2; exit 2 ;;
        esac
        exec qs ipc -p "$config" call desktop media "$2"
        ;;
    dock)
        case "${2:-}" in
            # "--" keeps qs from reading "show" as its own subcommand.
            # touch: shown for touch (no keyboard surface), as the assist button does in tablet mode.
            show|hide|toggle|touch) exec qs ipc -p "$config" call desktop dock -- "$2" ;;
            launch)
                if [[ "${3:-}" =~ ^[1-9]$ ]]; then
                    exec qs ipc -p "$config" call desktop dockLaunch "$3"
                fi
                ;;
        esac
        echo 'Usage: desktop-shell dock {show|hide|toggle|touch|launch 1-9}' >&2
        exit 2
        ;;
    overview)
        # The overview is opening: the shell watches the bars closely for a while.
        exec qs ipc -p "$config" call desktop overview
        ;;
    zoom)
        # Screen zoom around the pointer, with an OSD.
        case "${2:-}" in in|out|reset|toggle) exec qs ipc -p "$config" call desktop zoom "$2" ;; esac
        echo 'Usage: desktop-shell zoom {in|out|reset|toggle}' >&2
        exit 2
        ;;
    focus)
        # A focus session: Do Not Disturb for MINUTES (Config.focusMinutes without), then back as it was.
        case "${2:-}" in
            toggle|stop) exec qs ipc -p "$config" call desktop focus "$2" 0 ;;
            start)
                [[ "${3:-0}" =~ ^[0-9]+$ ]] || { echo 'Usage: desktop-shell focus {toggle|start [MINUTES]|stop}' >&2; exit 2; }
                exec qs ipc -p "$config" call desktop focus start "${3:-0}"
                ;;
        esac
        echo 'Usage: desktop-shell focus {toggle|start [MINUTES]|stop}' >&2
        exit 2
        ;;
    keep-awake|dnd|tablet|rotation-lock|night-shift)
        # Night shift also has its automatic mode.
        actions='toggle|on|off'
        [[ $1 == night-shift ]] && actions+='|auto'
        [[ "|$actions|" == *"|${2:-}|"* ]] || { echo "Usage: desktop-shell $1 {$actions}" >&2; exit 2; }
        # tablet: the tablet mode switch reports through here (config/tablet.lua). Posture changes go to the
        # journal (journalctl -t desktop-shell) with the process that asked, to follow them around the lock.
        if [[ $1 == tablet ]]; then
            logger -t desktop-shell "tablet $2 from $(ps -o comm= -p "$PPID" 2>/dev/null || echo unknown)" 2>/dev/null || true
        fi
        case $1 in
            dnd) target=quiet ;;
            tablet) target=tablet ;;
            rotation-lock) target=rotationLock ;;
            night-shift) target=nightShift ;;
            *) target=keepAwake ;;
        esac
        exec qs ipc -p "$config" call desktop "$target" -- "$2"
        ;;
    keyboard)
        # locked / unlocked come from desktop-power around hyprlock.
        case "${2:-}" in show|hide|toggle|float|dock|locked|unlocked) ;;
            *) echo 'Usage: desktop-shell keyboard {show|hide|toggle|float|dock|locked|unlocked}' >&2; exit 2 ;;
        esac
        exec qs ipc -p "$config" call desktop keyboard -- "$2"
        ;;
    assist)
        case "${2:-}" in show|hide|toggle|menu) ;;
            *) echo 'Usage: desktop-shell assist {show|hide|toggle|menu [apps|window|system]}' >&2; exit 2 ;;
        esac
        # menu PAGE opens the menu on that page.
        [[ $2 == menu && -n "${3:-}" ]] && exec qs ipc -p "$config" call desktop assistPage -- "$3"
        exec qs ipc -p "$config" call desktop assist -- "$2"
        ;;
    window-menu) exec qs ipc -p "$config" call desktop windowMenu ;;
    # The desktop menu (launcher, Settings, session), as a right click on the empty desktop opens it.
    desktop-menu) exec qs ipc -p "$config" call desktop desktopMenu ;;
    status) exec qs ipc -p "$config" call desktop status ;;
    *) echo 'Usage: desktop-shell {start|stop|supervise|restart [theming TAB]|status|toggle PANEL|switcher ACTION|focus ACTION|zoom ACTION|overview|media ACTION|dock ACTION|keep-awake ACTION|dnd ACTION|tablet ACTION|rotation-lock ACTION|night-shift ACTION|assist ACTION|keyboard ACTION|window-menu|desktop-menu}' >&2; exit 2 ;;
esac
