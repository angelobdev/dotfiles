#!/usr/bin/env bash
set -euo pipefail
config="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/desktop"
case "${1:-start}" in
    start) exec qs -p "$config" --no-duplicate --daemonize ;;
    stop) exec qs kill -p "$config" ;;
    restart)
        qs kill -p "$config" 2>/dev/null || true
        # kill requests shutdown; --no-duplicate can still see the exiting process.
        # Wait for Quickshell's instance lock to disappear before starting again.
        for attempt in {1..50}; do
            if ! qs list --json -p "$config" 2>/dev/null | python3 -c '
import json, sys
try:
    running = bool(json.load(sys.stdin))
except ValueError:
    running = False
sys.exit(0 if running else 1)
'; then
                exec qs -p "$config" --no-duplicate --daemonize
            fi
            sleep 0.1
        done
        echo 'The previous Quickshell instance did not exit within 5 seconds.' >&2
        exit 1
        ;;
    toggle)
        case "${2:-}" in launcher|controls|network|bluetooth|audio|battery|notifications|calendar|hints|wallpaper|clipboard|recording|power) ;;
            *) echo 'Usage: desktop-shell toggle {launcher|controls|network|bluetooth|audio|battery|notifications|calendar|hints|wallpaper|clipboard|recording|power}' >&2; exit 2 ;;
        esac
        exec qs ipc -p "$config" call desktop toggle "$2"
        ;;
    media)
        case "${2:-}" in play-pause|play|pause|next|previous|stop) ;;
            *) echo 'Usage: desktop-shell media {play-pause|play|pause|next|previous|stop}' >&2; exit 2 ;;
        esac
        exec qs ipc -p "$config" call desktop media "$2"
        ;;
    status) exec qs ipc -p "$config" call desktop status ;;
    *) echo 'Usage: desktop-shell {start|stop|restart|status|toggle PANEL|media ACTION}' >&2; exit 2 ;;
esac
